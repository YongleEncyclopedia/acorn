# Copy to .env and adjust. All values are optional.
ACORN_PORT=7700
# 0.0.0.0 lets phones on your network connect; use 127.0.0.1 for this computer only.
ACORN_HOST=0.0.0.0
# ACORN_DATA_DIR=data
# Address used in Telegram digests (e.g. your Tailscale name): http://my-computer.tail1234.ts.net:7700
# ACORN_PUBLIC_URL=
# Self-hosted RSSHub (see docker/compose.yml) is far more reliable than the public instance.
# RSSHUB_BASE=http://127.0.0.1:1200
# RSSHUB_ACCESS_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# First password, applied only while none is set; normally you set it in the browser on first run
# (Docker has no browser first-run setup). Change it later in Settings or with `acorn passwd`.
# ACORN_PASSWORD=
# Internet Archive used to rescue dead links during a move-in (point it at a mirror or proxy if needed).
# ACORN_WAYBACK_BASE=https://web.archive.org
