<?xml version="1.0" encoding="utf-8"?>
<!-- The two native screens (setup, offline), in the web app's look: paper, ink, the acorn brown. -->
<resources>
    <style name="Acorn" />

    <style name="Acorn.Panel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/bg</item>
        <!-- block touches from reaching the page underneath -->
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Acorn.Column">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/panel_side</item>
        <item name="android:paddingEnd">@dimen/panel_side</item>
        <item name="android:paddingTop">40dp</item>
        <item name="android:paddingBottom">40dp</item>
    </style>

    <style name="Acorn.Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Acorn.Lede">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Acorn.Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/field</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_3</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Acorn.Status">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Acorn.Hint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">@color/ink_3</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Acorn.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/button</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Acorn.Button.Primary">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/accent_contrast</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Acorn.Button.Quiet">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textColor">@color/ink_2</item>
    </style>
</resources>
