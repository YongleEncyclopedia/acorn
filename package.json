{
  "name": "acorn",
  "version": "0.1.0",
  "private": true,
  "description": "Acorn 松果：完全属于你的信息系统。订阅、阅读、批注、本地存档。",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": { "node": ">=22.18" },
  "bin": { "acorn": "./bin/acorn" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server/main.ts",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch-path=src src/server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cli": "node --disable-warning=ExperimentalWarning src/cli/main.ts",
    "mcp": "node --disable-warning=ExperimentalWarning src/mcp/server.ts",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@mozilla/readability": "0.6.0",
    "croner": "10.0.1",
    "fast-xml-parser": "5.11.2",
    "feedsmith": "3.0.1",
    "hono": "4.13.11",
    "linkedom": "0.18.13",
    "sanitize-html": "2.17.7",
    "turndown": "7.2.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.0",
    "@tanstack/react-query": "5.104.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "6.1.1",
    "dompurify": "3.4.16",
    "lucide-react": "1.49.0",
    "lxgw-wenkai-screen-webfont": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wouter": "3.12.0"
  }
}
